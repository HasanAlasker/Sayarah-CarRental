@{
    ViewData["Title"] = "Home Page";
}

<div class="py-5 text-center bg-white rounded shadow-sm mb-5">
    <div class="container py-5">
        <h1 class="display-4 fw-extrabold mb-3">Premium Car Rental for Your Next Adventure</h1>
        <p class="lead text-secondary mb-4 mx-auto" style="max-width: 700px;">
            Experience the freedom of the open road with our curated collection of high-quality vehicles. 
            From luxury sedans to rugged SUVs, we have the perfect ride for every occasion.
        </p>
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a asp-controller="Car" asp-action="Index" class="btn btn-primary btn-lg px-5 py-3 fw-bold shadow-sm">Browse Cars</a>
            <a asp-controller="User" asp-action="Register" class="btn btn-outline-secondary btn-lg px-5 py-3 fw-bold">Join Now</a>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center border-0 shadow-sm">
            <div class="bg-light rounded-circle p-3 mx-auto mb-3" style="width: fit-content;">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-shield-check text-primary" viewBox="0 0 16 16">
                    <path d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.775 11.775 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.158 7.158 0 0 0 1.048-.625 11.777 11.777 0 0 0 2.517-2.453c1.678-2.195 2.461-5.513 1.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0v-3A.5.5 0 0 1 8 5zm0 6a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1z"/>
                </svg>
            </div>
            <h5 class="fw-bold">Safe & Secure</h5>
            <p class="text-secondary small">All our vehicles undergo rigorous safety inspections and come with comprehensive insurance.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center border-0 shadow-sm">
            <div class="bg-light rounded-circle p-3 mx-auto mb-3" style="width: fit-content;">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-tag text-primary" viewBox="0 0 16 16">
                    <path d="M6 4.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm-1 0a.5.5 0 1 0-1 0 .5.5 0 0 0 1 0z"/>
                    <path d="M2 1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 1 6.586V2a1 1 0 0 1 1-1zm0 5.586 7 7L13.586 9l-7-7H2v4.586z"/>
                </svg>
            </div>
            <h5 class="fw-bold">Best Price Guaranteed</h5>
            <p class="text-secondary small">We offer competitive pricing and seasonal discounts to ensure you get the best value.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center border-0 shadow-sm">
            <div class="bg-light rounded-circle p-3 mx-auto mb-3" style="width: fit-content;">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-clock text-primary" viewBox="0 0 16 16">
                    <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                </svg>
            </div>
            <h5 class="fw-bold">24/7 Support</h5>
            <p class="text-secondary small">Our dedicated support team is always available to assist you with any questions or issues.</p>
        </div>
    </div>
</div>
